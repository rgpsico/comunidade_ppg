FROM node:20-alpine AS build

ARG VITE_API_BASE=https://api.comunidadeppg.com.br/api
ENV VITE_API_BASE=$VITE_API_BASE

WORKDIR /app
COPY cria-da-comunidade/package*.json ./
RUN npm install
COPY cria-da-comunidade/ .
RUN npm run build

FROM nginx:alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY docker/nginx/frontend.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
